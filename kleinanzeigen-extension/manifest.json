{
  "manifest_version": 3,
  "name": "Selling – Kleinanzeigen-Entwürfe",
  "version": "0.2.0",
  "description": "Überträgt einen freigegebenen Selling-Artikel in das Kleinanzeigen-Formular. Veröffentlicht niemals automatisch.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "selling-drafts@selling-tau.vercel.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "content_scripts": [
    { "matches": ["https://selling-tau.vercel.app/*"], "js": ["bridge.js"] },
    { "matches": ["https://www.kleinanzeigen.de/p-anzeige-aufgeben*"], "js": ["fill.js"] }
  ]
}
