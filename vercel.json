{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] },
    { "source": "/(app.js|search-engine.js|pwa.js|style.css|manifest.json)", "headers": [
      { "key": "Cache-Control", "value": "no-cache" }
    ] }
  ]
}
